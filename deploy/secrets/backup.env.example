# Template for /opt/tragni/secrets/backup.env on the server.
# The real file is mode 600 and never enters this repository.
#
# Values come from the Infomaniak Swiss Backup device page
# (Cloud-Speicherung -> device -> Zugangsdaten).

# Repository URL. The last path segment is the bucket; restic creates it.
RESTIC_REPOSITORY=s3:https://s3.swiss-backup02.infomaniak.com/tragni-vps

# Generated in the Infomaniak manager under "Zugriff -> Neue Schlüssel generieren".
# The secret key is shown once. Rotating these is cheap and safe.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Required by the S3 client; Infomaniak reports us-east-1.
AWS_DEFAULT_REGION=us-east-1

# Encrypts the backup contents, client side.
# LOSING THIS MAKES EVERY BACKUP PERMANENTLY UNREADABLE.
# Generate with: openssl rand -base64 32
# Store in the password manager AND at a second, independent location.
RESTIC_PASSWORD=
