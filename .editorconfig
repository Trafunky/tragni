root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.cs]
indent_size = 4

# Enforced in the build (EnforceCodeStyleInBuild), fails it via TreatWarningsAsErrors
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_diagnostic.IDE0005.severity = warning

[*.md]
# Two trailing spaces are a hard line break in Markdown
trim_trailing_whitespace = false

# EF Core writes these files. They are generated code: our style rules apply to
# what we write, not to what a tool emits.
[**/Migrations/*.cs]
generated_code = true

# Test names are sentences, not identifiers:
# FromTitle_TitleWithUppercaseLetters_ReturnsLowercaseSlug.
# CA1707 protects the public surface of a library — a concern that does not
# exist for test methods, which have no callers but the test runner.
[apps/api/tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none